{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/TASKS.md)",
      "Edit(/README.md)",
      "Edit(/factory/**)",
      "Edit(/tests/**)",
      "Edit(/Tools/**)",
      "Edit(/scripts/**)",
      "Edit(/unity_package/**)",
      "Edit(/Assets/**)",
      "Edit(/Packages/**)",
      "Edit(/ProjectSettings/**)",
      "Edit(/schemas/**)",
      "Edit(/docs/**)",
      "Edit(/.claude/**)",
      "Edit(/games/**)",
      "Edit(/.gitignore)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git worktree list *)",
      "Bash(git fetch origin main)",
      "Bash(git merge --ff-only origin/main)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin main)",
      "Bash(python -B *)",
      "Bash(python *)",
      "Bash(gh auth status)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git branch *)",
      "PowerShell(git remote *)",
      "PowerShell(git worktree list *)",
      "PowerShell(git fetch origin main)",
      "PowerShell(git merge --ff-only origin/main)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push origin main)",
      "PowerShell(python -B *)",
      "PowerShell(python *)",
      "PowerShell(gh auth status)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Location)",
      "PowerShell(Test-Path *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*token*)",
      "Read(**/*private_key*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(secrets/**)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git worktree remove *)",
      "Bash(rm -rf *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git worktree remove *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh run rerun *)"
    ]
  }
}
